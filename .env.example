# Kopirajte v .env in pred zagonom spremenite vrednosti.
POSTGRES_USER=soundroom
POSTGRES_PASSWORD=soundroom
POSTGRES_DB=soundroom

APP_SECRET_KEY=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-now
INITIAL_ADMIN_DISPLAY_NAME=Administrator

INITIAL_LISTENER_EMAIL=listener@example.com
INITIAL_LISTENER_PASSWORD=listener-password
INITIAL_LISTENER_DISPLAY_NAME=Listener

# Worker container endpoint for Ollama. Inside the worker,
# host.docker.internal resolves to the Docker host (your server). Ollama must
# therefore listen on an address reachable from containers, e.g. bind it with
# OLLAMA_HOST=0.0.0.0:11434 or publish port 11434 from its container. This
# works with the separate docker-compose.ollama.yml, a native host install,
# or an existing remote Ollama instance.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=laya
OLLAMA_TIMEOUT_SECONDS=30
# Minimum LLM probability required to auto-approve an ambiguous import.
# 0.0 accepts the model's top choice; raise it to require more confidence.
LLM_CONFIDENCE_THRESHOLD=0.0

MAX_UPLOAD_MB=50
MEDIA_STORAGE_PATH=./data/audio

# Extra hostnames accepted by the Vite dev server, comma-separated.
# Set this when the UI is served through a domain, for example:
# VITE_ALLOWED_HOSTS=soundroom.example.com,www.soundroom.example.com
# Use * to allow every hostname.
VITE_ALLOWED_HOSTS=

# Last.fm recommendations (server only; never expose to the browser)
# Only LASTFM_API_KEY is used for track.getSimilar. The shared secret and
# callback are for Last.fm Web Authentication, which this app does not use.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_BASE_URL=https://ws.audioscrobbler.com/2.0/
LASTFM_TIMEOUT_SECONDS=10
